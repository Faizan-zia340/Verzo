MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ai-content-generator
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
PORT=3001
CLIENT_URL=http://localhost:5000
FREE_DAILY_CREDITS=10

GEMINI_API_KEY=your_gemini_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Forgot-password email (optional; reset emails are not sent without these)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=your_verified_sender_here

# Media uploads (Cloudinary) — optional; uploads return 503 without these.
# Free account at cloudinary.com -> dashboard -> copy the 3 values and set
# them as Render env vars. Never commit real values here.
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
